# Build output
build/
.gradle/
out/

# Run directory: whitelist. Only the configs the autotest relies on are kept;
# game state, logs, captures and debug dumps stay local. A new config that should
# be shared needs its own "!" line below.
run/*
!run/client/
run/client/*
!run/client/config/
run/client/config/*
!run/client/config/catalogue.cfg
!run/client/config/cleanroom_mod_list_favourites.txt
!run/client/config/forge.cfg
!run/client/config/forgeChunkLoading.cfg
!run/client/config/forge_early.cfg
!run/client/config/kirino_engine.cfg
!run/client/config/vesu_settings.json
!run/client/config/cleanroom/
run/client/config/cleanroom/*
!run/client/config/cleanroom/compatibility.cfg

# IDE
.idea/
*.iml
.vscode/

# Agent/audit notes (local only)
AGENTS.md
AUDIT.md
AUDIT-drafts/
