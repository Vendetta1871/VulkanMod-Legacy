+// std::wstring_convert/std::codecvt have been removed from recent C++ standard
+// libraries, so the UTF-8 <-> UTF-32 (wchar_t on this platform) conversions the
+// backend needs for debug names are implemented directly.
+static uint32_t decodeUTF8(const unsigned char*& cursor)
+{
+    const uint32_t lead = *cursor++;
+    if (lead < 0x80)
+        return lead;
+
+    uint32_t codePoint = 0;
+    uint32_t trailing  = 0;
+    if ((lead & 0xE0) == 0xC0)
+    {
+        codePoint = lead & 0x1F;
+        trailing  = 1;
+    }
+    else if ((lead & 0xF0) == 0xE0)
+    {
+        codePoint = lead & 0x0F;
+        trailing  = 2;
+    }
+    else if ((lead & 0xF8) == 0xF0)
+    {
+        codePoint = lead & 0x07;
+        trailing  = 3;
+    }
+    else
+    {
+        return 0xFFFD;  // invalid lead byte
+    }
+
+    for (uint32_t i = 0; i < trailing; ++i)
+    {
+        if ((*cursor & 0xC0) != 0x80)
+            return 0xFFFD;
+        codePoint = (codePoint << 6) | (*cursor++ & 0x3F);
+    }
+    return codePoint;
+}
