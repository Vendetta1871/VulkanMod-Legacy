{
  "_comment": "Vesu material rules: first rule whose regex matches the sprite path wins. Field reference: net.vesu.vulkan.rt.RtMaterialRules. A resource pack's own _s/_n maps take precedence.",
  "rules": [
    {"match": "^blocks/destroy_stage_|^blocks/debug|^blocks/structure_block|^blocks/redstone_dust_|^blocks/water_overlay", "normal": 0, "ao": 0},

    {"match": "^blocks/(water_still|water_flow)$", "smoothness": 1.0, "f0": 0.02, "normal": 0, "ao": 0},
    {"match": "^blocks/(lava_still|lava_flow)$", "smoothness": 0.3, "normal": 0.6, "ao": 0,
     "emission": {"mask": "all", "peak": 0.85, "byValue": true}},
    {"match": "^blocks/fire_layer_", "normal": 0, "ao": 0, "emission": {"mask": "all", "peak": 0.6, "byValue": true}},
    {"match": "^blocks/portal$", "smoothness": 0.8, "normal": 0, "ao": 0, "emission": {"mask": "all", "peak": 0.15, "byValue": true}},
    {"match": "^blocks/glowstone$", "smoothness": 0.35, "normal": 1.0, "ao": 0.5, "emission": {"mask": "all", "peak": 0.55, "byValue": true}},
    {"match": "^blocks/sea_lantern$", "smoothness": 0.75, "normal": 0.6, "ao": 0.3, "emission": {"mask": "all", "peak": 0.6, "byValue": true}},
    {"match": "^blocks/redstone_lamp_on$", "smoothness": 0.5, "normal": 1.0, "ao": 0.5, "emission": {"mask": "all", "peak": 0.75, "byValue": true}},
    {"match": "^blocks/magma$", "smoothness": 0.3, "normal": 1.5, "emission": {"mask": "bright", "from": 0.55, "to": 0.85, "peak": 0.5}},
    {"match": "^blocks/(torch_on)$", "smoothness": 0.2, "normal": 0, "ao": 0, "emission": {"mask": "bright", "from": 0.9, "to": 0.98, "peak": 0.9}},
    {"match": "^blocks/redstone_torch_on$", "smoothness": 0.2, "normal": 0, "ao": 0, "emission": {"mask": "red", "from": 0.35, "to": 0.6, "peak": 0.8}},
    {"match": "^blocks/(repeater_on|comparator_on|observer_back_lit|rail_(golden|activator|detector)_powered)$", "smoothness": 0.35, "normal": 0.6,
     "emission": {"mask": "red", "from": 0.35, "to": 0.6, "peak": 0.25}},
    {"match": "^blocks/pumpkin_face_on$", "smoothness": 0.45, "normal": 0.8, "emission": {"mask": "pale", "from": 0.65, "to": 0.8, "peak": 0.9}},
    {"match": "^blocks/furnace_front_on$", "smoothness": 0.2, "normal": 1.2, "emission": {"mask": "bright", "from": 0.75, "to": 0.95, "peak": 0.8}},
    {"match": "^blocks/end_rod$", "smoothness": 0.6, "normal": 0, "ao": 0, "emission": {"mask": "pale", "from": 0.85, "to": 0.95, "peak": 0.95}},
    {"match": "^blocks/beacon$", "smoothness": 0.9, "normal": 0, "emission": {"mask": "pale", "from": 0.8, "to": 0.95, "peak": 0.9}},

    {"match": "^blocks/(iron_block|iron_bars|door_iron_|iron_trapdoor|anvil_|cauldron_|hopper_)", "smoothness": 0.55, "smoothnessVar": 0.3, "metal": "iron", "normal": 0.8},
    {"match": "^blocks/gold_block$", "smoothness": 0.75, "smoothnessVar": 0.2, "metal": "gold", "normal": 0.6},
    {"match": "^blocks/rail_golden", "smoothness": 0.5, "metal": "gold", "metalMask": "yellow", "normal": 0.5},
    {"match": "^blocks/(rail_|trip_wire_source|lever|piston_)", "smoothness": 0.45, "metal": "iron", "metalMask": "gray", "normal": 0.6},
    {"match": "^blocks/iron_ore$", "smoothness": 0.15, "smoothnessVar": 0.2, "metal": "iron", "metalMask": "ore", "normal": 1.5},
    {"match": "^blocks/gold_ore$", "smoothness": 0.15, "smoothnessVar": 0.2, "metal": "gold", "metalMask": "ore", "normal": 1.5},
    {"match": "^blocks/(diamond|emerald)_ore$", "smoothness": 0.15, "smoothnessVar": 0.2, "metalMask": "ore", "maskF0": 0.17, "normal": 1.5},
    {"match": "^blocks/(lapis|redstone|quartz|coal)_ore$", "smoothness": 0.15, "smoothnessVar": 0.2, "metalMask": "ore", "maskF0": 0.06, "normal": 1.5},
    {"match": "^blocks/diamond_block$", "smoothness": 0.85, "f0": 0.17, "normal": 0.5},
    {"match": "^blocks/emerald_block$", "smoothness": 0.8, "f0": 0.07, "normal": 0.5},
    {"match": "^blocks/(lapis_block|redstone_block)$", "smoothness": 0.55, "f0": 0.05, "normal": 0.7},
    {"match": "^blocks/coal_block$", "smoothness": 0.45, "smoothnessVar": 0.3, "normal": 1.0},
    {"match": "^blocks/quartz_", "smoothness": 0.65, "f0": 0.045, "normal": 0.4, "ao": 0.5},
    {"match": "^blocks/obsidian$", "smoothness": 0.85, "smoothnessVar": 0.2, "f0": 0.045, "normal": 0.6},

    {"match": "^blocks/(glass|ice$|frosted_ice)", "smoothness": 0.95, "normal": 0, "ao": 0},
    {"match": "^blocks/ice_packed$", "smoothness": 0.8, "f0": 0.02, "normal": 0.3, "ao": 0},
    {"match": "^blocks/slime$", "smoothness": 0.85, "subsurface": 0.6, "normal": 0.3, "ao": 0},
    {"match": "^blocks/(snow|grass_side_snowed)$", "smoothness": 0.3, "subsurface": 0.5, "normal": 0.6, "ao": 0.5},

    {"match": "^blocks/leaves_", "smoothness": 0.13, "subsurface": 1.0, "normal": 0.4, "ao": 0},
    {"match": "^blocks/(tallgrass|fern|double_plant_|deadbush|sapling_|flower_|mushroom_(red|brown)$|reeds|vine|waterlily|wheat_|carrots_|potatoes_|beetroots_|nether_wart_stage|melon_stem|pumpkin_stem|cocoa_|chorus_flower|web)", "smoothness": 0.12, "subsurface": 0.8, "normal": 0, "ao": 0},
    {"match": "^blocks/mushroom_block_", "smoothness": 0.15, "subsurface": 0.4, "normal": 0.8},
    {"match": "^blocks/cactus_", "smoothness": 0.4, "subsurface": 0.3, "normal": 1.0},
    {"match": "^blocks/(melon_|pumpkin_)", "smoothness": 0.45, "smoothnessVar": 0.2, "normal": 0.8},
    {"match": "^blocks/(grass_top|grass_side|grass_side_overlay|grass_path_)", "smoothness": 0.1, "porosity": 0.5, "normal": 1.2},
    {"match": "^blocks/(dirt|coarse_dirt|dirt_podzol_|mycelium_|farmland_dry)", "smoothness": 0.05, "porosity": 0.8, "normal": 1.4},
    {"match": "^blocks/farmland_wet$", "smoothness": 0.25, "porosity": 0.8, "normal": 1.2},
    {"match": "^blocks/(sand|red_sand|gravel|soul_sand|concrete_powder_)", "smoothness": 0.05, "porosity": 0.9, "normal": 1.2},
    {"match": "^blocks/clay$", "smoothness": 0.3, "porosity": 0.6, "normal": 0.8},
    {"match": "^blocks/(sponge|sponge_wet)$", "smoothness": 0.05, "porosity": 1.0, "normal": 1.4},
    {"match": "^blocks/hay_block_", "smoothness": 0.2, "porosity": 0.6, "normal": 1.2},
    {"match": "^blocks/wool_colored_", "smoothness": 0.0, "porosity": 1.0, "normal": 0.8, "ao": 0.6},

    {"match": "^blocks/(stone_andesite_smooth|stone_diorite_smooth|stone_granite_smooth)$", "smoothness": 0.6, "smoothnessVar": 0.2, "normal": 0.5},
    {"match": "^blocks/(stone_andesite|stone_diorite|stone_granite)$", "smoothness": 0.3, "smoothnessVar": 0.2, "normal": 1.2},
    {"match": "^blocks/stone$|^blocks/stone_slab_", "smoothness": 0.25, "smoothnessVar": 0.2, "normal": 1.2},
    {"match": "^blocks/(cobblestone|cobblestone_mossy|mob_spawner)$", "smoothness": 0.2, "smoothnessVar": 0.3, "normal": 1.8},
    {"match": "^blocks/(stonebrick|end_bricks|nether_brick|red_nether_brick|prismarine_bricks|brick)", "smoothness": 0.25, "smoothnessVar": 0.3, "normal": 1.6},
    {"match": "^blocks/(sandstone_smooth|red_sandstone_smooth|sandstone_top|red_sandstone_top)$", "smoothness": 0.3, "porosity": 0.4, "normal": 0.8},
    {"match": "^blocks/(red_)?sandstone_", "smoothness": 0.2, "porosity": 0.4, "normal": 1.4},
    {"match": "^blocks/(netherrack|end_stone|bedrock)$", "smoothness": 0.1, "smoothnessVar": 0.2, "normal": 1.6},
    {"match": "^blocks/prismarine_", "smoothness": 0.45, "smoothnessVar": 0.2, "normal": 1.2},
    {"match": "^blocks/purpur_", "smoothness": 0.4, "normal": 1.0},
    {"match": "^blocks/(nether_wart_block|bone_block_)", "smoothness": 0.3, "normal": 1.2},
    {"match": "^blocks/concrete_", "smoothness": 0.45, "normal": 0.3, "ao": 0.3},
    {"match": "^blocks/glazed_terracotta_", "smoothness": 0.85, "f0": 0.045, "normal": 0.5},
    {"match": "^blocks/hardened_clay", "smoothness": 0.3, "porosity": 0.3, "normal": 0.6},

    {"match": "^blocks/log_", "smoothness": 0.15, "smoothnessVar": 0.2, "normal": 1.4},
    {"match": "^blocks/(planks_|door_|trapdoor|crafting_table|bookshelf|jukebox|noteblock|ladder|chorus_plant|itemframe)", "smoothness": 0.3, "smoothnessVar": 0.25, "normal": 1.2},
    {"match": "^blocks/(furnace_|dispenser_|dropper_|observer_)", "smoothness": 0.25, "smoothnessVar": 0.3, "normal": 1.4},
    {"match": "^blocks/(enchanting_table|endframe|dragon_egg|command_block|chain_command|repeating_command|brewing_stand)", "smoothness": 0.5, "normal": 1.0},
    {"match": "^blocks/", "smoothness": 0.2, "smoothnessVar": 0.2, "normal": 1.0},

    {"match": "^items/(iron_|chainmail_|bucket|shears|minecart|compass|bucket_|flint_and_steel|hopper|cauldron)", "smoothness": 0.6, "metal": "iron", "metalMask": "gray", "normal": 0, "ao": 0},
    {"match": "^items/(gold_|clock)", "smoothness": 0.75, "metal": "gold", "metalMask": "yellow", "normal": 0, "ao": 0},
    {"match": "^items/(diamond|emerald)", "smoothness": 0.85, "f0": 0.17, "normal": 0, "ao": 0},
    {"match": "^items/(glass_bottle|potion_bottle|experience_bottle|ender_pearl|ender_eye|nether_star)", "smoothness": 0.9, "normal": 0, "ao": 0},
    {"match": "^items/", "smoothness": 0.25, "normal": 0, "ao": 0}
  ]
}
