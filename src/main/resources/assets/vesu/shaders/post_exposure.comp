#version 450
// HDR post (PostProcess), exposure: the mean log2 luminance of the coarsest level, turned
// into an exposure that brings it to the key value, kept within an EV window around the
// base exposure and eased over time (auto-exposure). One workgroup.

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D coarse;
layout(set = 0, binding = 1, rg32f) uniform image2D exposure;   // 1x1: x the adapted exposure, y the mean log2 luminance

layout(push_constant) uniform Constants {
    vec4 params;   // x: key, y: min EV, z: max EV, w: adaptation (0..1 of the way this frame)
    vec4 extra;    // x: 1 resets to the target at once
} pc;

layout(local_size_x = 64) in;

shared float sums[64];
shared float counts[64];

void main() {
    ivec2 size = imageSize(coarse);
    int total = size.x * size.y;
    float s = 0.0, c = 0.0;
    for (int i = int(gl_LocalInvocationID.x); i < total; i += 64) {
        ivec2 q = ivec2(i % size.x, i / size.x);
        // Centre-weighted metering: the middle of the screen counts more.
        vec2 uv = (vec2(q) + 0.5) / vec2(size) - 0.5;
        float w = 1.0 - 0.75 * clamp(length(uv) * 1.6, 0.0, 1.0);
        s += imageLoad(coarse, q).a * w;
        c += w;
    }
    sums[gl_LocalInvocationID.x] = s;
    counts[gl_LocalInvocationID.x] = c;
    barrier();
    if (gl_LocalInvocationID.x != 0u) return;
    float ts = 0.0, tc = 0.0;
    for (int i = 0; i < 64; i++) { ts += sums[i]; tc += counts[i]; }
    float meanLog = ts / max(tc, 1e-5);
    float ev = clamp(log2(pc.params.x) - meanLog, pc.params.y, pc.params.z);
    float target = exp2(ev);
    float prev = imageLoad(exposure, ivec2(0)).x;
    float adapted = pc.extra.x > 0.5 || !(prev > 0.0) ? target : exp2(mix(log2(prev), ev, pc.params.w));
    imageStore(exposure, ivec2(0), vec4(adapted, meanLog, 0.0, 0.0));
}
