#version 450
// HDR post (PostProcess), the film chain after docs/rt-production-look.md section 3, in
// place on the scene color before the upscaler.
//
// The scene holds gamma-encoded HDR: vanilla's raster output as is (0..1, display encoded)
// with the ray-traced light allowed above 1 (rt_composite, reflections). Here it is
// linearized (2.2), the bloom of the coarse levels is added (only light above the
// threshold feeds it), a local adaptation lifts shadows and holds highlights back
// (shadows / highlights strength), the global auto-exposure and exposure bias apply, and the
// ACES curve maps it to the display, encoded back to gamma 2.2.

layout(set = 0, binding = 0, rgba16f) uniform image2D sceneColor;
layout(set = 0, binding = 1) uniform sampler2D level1;
layout(set = 0, binding = 2) uniform sampler2D level2;
layout(set = 0, binding = 3) uniform sampler2D level3;
layout(set = 0, binding = 4) uniform sampler2D level4;
layout(set = 0, binding = 5) uniform sampler2D level5;
layout(set = 0, binding = 6, rg32f) uniform readonly image2D exposure;   // x: exposure, y: mean log2 luminance

layout(push_constant) uniform Constants {
    vec4 params;   // x: exposure bias (linear), y: bloom strength, z: local shadows lift, w: local highlights hold
    vec4 extra;    // x: local adaptation strength (0..1), y: 1 shows the scene unchanged (debug)
} pc;

layout(local_size_x = 8, local_size_y = 8) in;

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// ACES filmic curve: Stephen Hill's fit of the RRT + ODT with the sRGB <-> ACES matrices
// (RTX Remix's current ACES; the Narkowicz fit is its legacy option).
const mat3 ACES_IN = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
const mat3 ACES_OUT = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
vec3 aces(vec3 x) {
    vec3 v = ACES_IN * x;
    v = (v * (v + 0.0245786) - 0.000090537) / (v * (0.983729 * v + 0.4329510) + 0.238081);
    return clamp(ACES_OUT * v, 0.0, 1.0);
}

// 3x3 tent of a level (bilinear taps one texel apart): round, soft halos instead of the
// box-downsampled squares.
vec3 tent(sampler2D level, vec2 uv) {
    vec2 t = 1.0 / vec2(textureSize(level, 0));
    vec3 c = textureLod(level, uv, 0.0).rgb * 4.0;
    c += (textureLod(level, uv + vec2(t.x, 0.0), 0.0).rgb + textureLod(level, uv - vec2(t.x, 0.0), 0.0).rgb
            + textureLod(level, uv + vec2(0.0, t.y), 0.0).rgb + textureLod(level, uv - vec2(0.0, t.y), 0.0).rgb) * 2.0;
    c += textureLod(level, uv + t, 0.0).rgb + textureLod(level, uv - t, 0.0).rgb
            + textureLod(level, uv + vec2(t.x, -t.y), 0.0).rgb + textureLod(level, uv + vec2(-t.x, t.y), 0.0).rgb;
    return c / 16.0;
}

// The tent of the log luminance (alpha).
float tentA(sampler2D level, vec2 uv) {
    vec2 t = 1.0 / vec2(textureSize(level, 0));
    float c = textureLod(level, uv, 0.0).a * 4.0;
    c += (textureLod(level, uv + vec2(t.x, 0.0), 0.0).a + textureLod(level, uv - vec2(t.x, 0.0), 0.0).a
            + textureLod(level, uv + vec2(0.0, t.y), 0.0).a + textureLod(level, uv - vec2(0.0, t.y), 0.0).a) * 2.0;
    c += textureLod(level, uv + t, 0.0).a + textureLod(level, uv - t, 0.0).a
            + textureLod(level, uv + vec2(t.x, -t.y), 0.0).a + textureLod(level, uv + vec2(-t.x, t.y), 0.0).a;
    return c / 16.0;
}

void main() {
    ivec2 size = imageSize(sceneColor);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    vec4 c = imageLoad(sceneColor, p);
    if (pc.extra.y > 0.5) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec3 lin = pow(max(c.rgb, vec3(0.0)), vec3(2.2));

    // Bloom: the thresholded levels, wider ones weaker.
    // Broad: the wide levels weigh as much as the narrow ones (Remix's 8-step bloom).
    vec3 bloom = tent(level1, uv) * 0.2 + tent(level2, uv) * 0.2 + tent(level3, uv) * 0.2
            + tent(level4, uv) * 0.2 + tent(level5, uv) * 0.2;
    lin += bloom * pc.params.y;

    // Local adaptation: the neighbourhood's luminance (level 4, ~1/32 of the screen) against
    // the frame's mean (post_exposure). Darker neighbourhoods get up to "shadows" times more
    // exposure, brighter ones down to 1 / "highlights".
    vec2 ex = imageLoad(exposure, ivec2(0)).xy;
    // Tent-filtered and spread over three levels: one bilinear level drew its texel grid as
    // blocks of different exposure around bright areas (the sun at sunset).
    float localLog = 0.25 * tentA(level3, uv) + 0.4 * tentA(level4, uv) + 0.35 * tentA(level5, uv);
    // Within 1 EV of the pixel's own luminance: a bright pixel next to dark terrain (the sky over
    // a silhouette) is not lifted with it, a dark one next to the sun not crushed - no halos.
    float pixelLog = log2(luminance(lin) + 1e-4);
    localLog = clamp(localLog, pixelLog - 1.0, pixelLog + 1.0);
    float gain = exp2(clamp(ex.y - localLog, -log2(pc.params.w), log2(pc.params.z)) * pc.extra.x);

    // Saturation 0.8 before the curve: vanilla textures times biome tints are far more
    // saturated in linear light than the PBR materials the reference look was tuned with.
    lin = max(lin, vec3(0.0));

    float e = ex.x;
    vec3 mapped = aces(lin * (e * pc.params.x * gain));
    imageStore(sceneColor, p, vec4(pow(mapped, vec3(1.0 / 2.2)), c.a));
}
