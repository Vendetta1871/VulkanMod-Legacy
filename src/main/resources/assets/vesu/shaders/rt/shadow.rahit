#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#define RT_HIT
#include "common.glsl"
// Shadow rays: cutout texels below vanilla's alpha threshold let light through; stained
// glass and ice filter it by their color (each primitive once: NO_DUPLICATE_ANY_HIT), and
// water is skipped (vanilla already tints what is seen through it). Anything else occludes.

layout(location = 1) rayPayloadInEXT vec4 shadow;
hitAttributeEXT vec2 bary;

void main() {
    ChunkVertex a, b, c;
    fetchTriangle(a, b, c);
    vec3 w = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
    vec4 tex = textureLod(blockAtlas, a.uv * w.x + b.uv * w.y + c.uv * w.z, 0.0);
    if (tex.a < 0.1) {
        ignoreIntersectionEXT;
    }
    if ((gl_InstanceCustomIndexEXT & INSTANCE_TRANSLUCENT) != 0) {
        vec4 tint = unpackUnorm4x8(a.color) * w.x + unpackUnorm4x8(b.color) * w.y + unpackUnorm4x8(c.color) * w.z;
        // Water (a biome hue; face shading and occlusion in vertex colors are grey).
        if (max(max(tint.r, tint.g), tint.b) - min(min(tint.r, tint.g), tint.b) > 0.08) {
            ignoreIntersectionEXT;
        }
        // Light through colored glass is multiplied by its transmittance - the texture color,
        // lifted a little (^0.8) so a single pane still reads - never renormalized: a pane
        // that passes 30% of the red light leaves it at 30%, dim and red, and a stack of panes
        // goes dark and deep (docs/rt-production-look.md, section 2.3).
        vec3 color = pow(tex.rgb, vec3(0.8));   // the vertex color is shading only here
        shadow.rgb *= mix(vec3(1.0), color, min(tex.a * 2.0, 1.0));
        ignoreIntersectionEXT;
    }
}
