#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// SHaRC update (see sharc.glsl): one path per launch cell, from a random pixel of its tile of
// the screen. Each vertex takes direct light (a sun or moon shadow ray, one block light picked
// uniformly from its light grid cell with a shadow ray), its emission and, by a cosine-weighted
// bounce, the light of the next vertex; the last bounce ends in the cache itself (all further
// bounces) or the sky. Every vertex adds the radiance it sends back to its voxel.

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 4) uniform sampler2D sceneDepth;

// The lighting pass's constants (RtLightingPass).
layout(push_constant) uniform Constants {
    mat4 invViewProj;
    mat4 prevViewProj;
    vec4 light;         // xyz: towards the sun/moon, w: 1 when it can light
    vec4 params;        // y: frame, w: light grid mask
    vec4 cam;           // xyz: camera - light origin, w: light count
    vec4 camDelta;      // w: sky source radiance (atmosphere.glsl)
    vec4 sky;           // rgb: mean upper sky radiance
    vec4 restir;        // z: dynamic light count
    vec4 viewRowZ;
    vec4 ddgiFlags;     // yzw: direct sun/moon irradiance
} pc;

#include "atmosphere.glsl"
#include "lights.glsl"
#define SHARC_WRITE
#include "sharc.glsl"

layout(location = 0) rayPayloadEXT Payload payload;
layout(location = 1) rayPayloadEXT vec4 shadow;

const int BOUNCES = 2;   // vertices after the first; the last one's light comes from the cache
const float PI = 3.14159265;

uint rngState;
uint pcg() {
    rngState = rngState * 747796405u + 2891336453u;
    uint w = ((rngState >> ((rngState >> 28u) + 4u)) ^ rngState) * 277803737u;
    return (w >> 22u) ^ w;
}
float rand() { return float(pcg() >> 8) * (1.0 / 16777216.0); }

float brightness(float l) { return l / (4.0 - 3.0 * l); }

float emissionOf(vec4 material) {
    return material.a < 254.5 / 255.0 ? material.a * (255.0 / 254.0) : 0.0;
}

vec3 traceShadow(vec3 origin, vec3 dir, float tMax, uint mask) {
    shadow = vec4(1.0, 1.0, 1.0, 0.0);
    traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                mask, SHADOW_HIT_GROUP, 0, 1, origin, 0.0, dir, tMax, 1);
    return shadow.rgb * shadow.a;
}

vec3 unproject(ivec2 p, float depth, vec2 size) {
    vec2 uv = (vec2(p) + 0.5) / size;
    vec4 h = pc.invViewProj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return h.xyz / h.w;
}

// One block light, picked uniformly among the lights of the point's grid cell and the
// dynamic lights, through a shadow ray; divided by its pick probability.
vec3 blockLightSample(vec3 pos, vec3 n) {
    int count = 0, start = 0;
    if (pc.cam.w > 0.0) {
        int slot = findCell(ivec3(floor((pos + pc.cam.xyz) / float(CELL))));
        if (slot >= 0) {
            int packed = cells[slot].w;
            start = packed & 0xFFFFFF;
            count = (packed >> 24) & 0xFF;
        }
    }
    int total = count + int(pc.restir.z);
    if (total <= 0) return vec3(0.0);
    int k = min(int(rand() * float(total)), total - 1);
    int li = k < count ? lightIndex[start + k] : DYNAMIC + (k - count);
    vec3 toLight;
    float dist;
    vec4 l = lightAt(li);
    float target = lightTarget(l, pos, n, toLight, dist);
    if (target <= 0.0) return vec3(0.0);
    vec3 center = l.xyz - pc.cam.xyz;
    vec3 origin = pos + n * 0.02;
    vec3 dir = center - origin;
    float len = length(dir);
    dir /= max(len, 1e-4);
    bool dynamic = li >= DYNAMIC;
    float tMax = dynamic ? len - 0.35 : blockEntry(origin, dir, center) - 0.01;
    vec3 vis = tMax > 0.05 ? traceShadow(origin, dir, tMax, dynamic ? 0x0Bu : 0x0Fu) : vec3(1.0);
    return vis * lightColor(li) * (target * float(total));
}

// Radiance leaving a hit the cache does not know yet: its albedo under the open sky's light
// scaled by vanilla's sky light, a share of the direct light, and its emission.
vec3 fallbackRadiance(vec3 albedo, float skyLight, float emission) {
    vec3 e = vec3(PI * dot(pc.sky.rgb, vec3(0.2126, 0.7152, 0.0722)) * brightness(skyLight))
            + pc.ddgiFlags.yzw * 0.5 * skyLight * skyLight;
    return albedo / PI * e + albedo * (10.0 * emission);
}

void main() {
    ivec2 id = ivec2(gl_LaunchIDEXT.xy);
    ivec2 launch = ivec2(gl_LaunchSizeEXT.xy);
    ivec2 full = textureSize(sceneDepth, 0);
    ivec2 tile = (full + launch - 1) / launch;
    rngState = uint(id.x) * 1973u + uint(id.y) * 9277u + uint(pc.params.y) * 26699u + 0x51ED27u;
    pcg();
    ivec2 p = min(id * tile + ivec2(vec2(rand(), rand()) * vec2(tile)), full - 1);
    float d = texelFetch(sceneDepth, p, 0).r;
    float farD = farPlaneDepth(pc.invViewProj);
    if (isSkyDepth(d, farD)) return;
    vec3 pos = unproject(p, d, vec2(full));
    vec3 eye = unproject(p, 1.0 - farD, vec2(full));
    vec3 view = pos - eye;
    float dist = length(view);
    if (!(dist > 1e-4) || any(isnan(pos)) || any(isinf(pos))) return;
    vec3 dir = view / dist;
    float slack = 0.05 + 0.01 * dist;
    payload.t = -1.0;
    payload.backface = 0.0;
    payload.cone = 0.0;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x03, 0, 0, 0, eye, max(dist - slack, 0.0), dir, dist + slack, 0);
    if (payload.t < 0.0 || any(isnan(payload.normal))) return;
    vec3 origin = eye;

    int slots[BOUNCES + 1];
    vec3 albedos[BOUNCES + 1], selfLight[BOUNCES + 1];
    vec3 incoming = vec3(0.0);
    int last = -1;
    // The sun itself (pc.light is the moon at night; the path-traced pass flags that in restir.y).
    vec3 sunDir = pc.restir.y < 0.0 ? -pc.light.xyz : pc.light.xyz;
    for (int k = 0; k <= BOUNCES; k++) {
        vec3 hit = origin + dir * payload.t;
        vec3 n = payload.normal;
        if (dot(n, dir) > 0.0) n = -n;
        vec3 albedo = pow(payload.albedo, vec3(2.2));
        float skyLight = payload.skyLight;
        float emission = emissionOf(payload.material);
        if (payload.backface > 0.5) break;   // inside geometry: no light
        last = k;
        // Direct light at the vertex.
        vec3 e = blockLightSample(hit, n);
        float ndl = dot(n, pc.light.xyz);
        if (pc.light.w > 0.0 && ndl > 0.0 && skyLight > 0.01) {
            e += traceShadow(hit + n * 0.02, pc.light.xyz, 512.0, 0x0Fu) * pc.ddgiFlags.yzw * ndl;
        }
        slots[k] = sharcInsert(hit, n);
        albedos[k] = albedo;
        selfLight[k] = albedo / PI * e + albedo * (10.0 * emission);

        // Cosine-weighted bounce: the incoming radiance times the albedo is the outgoing.
        vec3 t1 = normalize(abs(n.y) < 0.9 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
        vec3 t2 = cross(n, t1);
        float phi = 6.2831853 * rand();
        float r2 = rand();
        float sr = sqrt(r2);
        dir = normalize(t1 * (cos(phi) * sr) + t2 * (sin(phi) * sr) + n * sqrt(1.0 - r2));
        origin = hit + n * 0.02;
        if (any(isnan(dir)) || any(isnan(origin))) break;
        payload.t = -1.0;
        payload.backface = 0.0;
        payload.cone = 0.0;
        traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x07, 0, 0, 0, origin, 0.0, dir, 128.0, 0);
        if (payload.t < 0.0) {
            // The sky, scaled by vanilla's sky light as the lighting pass does (rays leaving
            // through unloaded or out-of-range geometry).
            incoming = atmosphere(dir, sunDir, pc.camDelta.w, pc.sky.rgb) * brightness(skyLight);
            break;
        }
        if (k == BOUNCES || any(isnan(payload.normal))) {
            vec3 hn = payload.normal;
            if (dot(hn, dir) > 0.0) hn = -hn;
            vec3 at = origin + dir * payload.t;
            vec4 cached = payload.backface > 0.5 ? vec4(0.0, 0.0, 0.0, 1.0) : sharcQuery(at, hn);
            incoming = cached.w > 0.0 ? cached.rgb
                    : fallbackRadiance(pow(payload.albedo, vec3(2.2)), payload.skyLight, emissionOf(payload.material));
            break;
        }
    }
    vec3 radiance = incoming;
    for (int k = BOUNCES; k >= 0; k--) {
        if (k > last) continue;
        radiance = selfLight[k] + albedos[k] * radiance;
        sharcAdd(slots[k], radiance, rand());
    }
}
