#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require
#include <rt/atmosphere.glsl>
// The two compute steps around Ray Reconstruction in the path-traced mode (RtLightingPass):
//  - mode 0, before RR: the pixels pathtrace.rgen left marked get their radiance - the sky and
//    the clouds (as rt_composite.comp draws them), or the vanilla-lit color converted to scene
//    units without vanilla's fog (entities and tile entities outside the scene, terrain past
//    the range) - so RR sees one complete, continuous image;
//  - mode 1, after RR: its denoised, anti-aliased radiance becomes the scene color (terrain past
//    60-75% of the render distance fading into the sky, as Remix does), gamma-encoded like the
//    rest of the post chain's input.

layout(set = 0, binding = 0) uniform sampler2D sceneDepth;
layout(set = 0, binding = 1, rgba16f) uniform image2D sceneColor;
layout(set = 0, binding = 2, scalar) buffer RrInputs { float rr[]; };
layout(set = 0, binding = 3, scalar) readonly buffer RrOutput { float rrOut[]; };

// rt_composite.comp's layout (RtLightingPass fills both alike).
layout(push_constant) uniform Constants {
    mat4 invViewProj;   // jittered
    vec4 params;
    vec4 flags;         // y: 1 shows RR's input (debug), z: mode (0 before RR, 1 after), w: RR output row length (padded width)
    vec4 sun;           // xyz: towards the sun, w: sky source radiance (atmosphere.glsl)
    vec4 direct;        // rgb: irradiance of the direct light
    vec4 lightDir;      // xyz: towards the direct light, w: vanilla's terrain fog end (blocks, LOD-scaled)
    vec4 skyMean;       // rgb: mean upper sky radiance, w: vanilla white -> scene units
    vec4 clouds;        // xz: camera in the cloud pattern, y: layer bottom - camera, w: 1 on
    vec4 fog;           // rgb: vanilla's fog color (display encoded), w: fog start
    vec4 fogEnd;        // x: fog end
} pc;

layout(local_size_x = 8, local_size_y = 8) in;

const float PI = 3.14159265;
#include <rt/sky.glsl>

vec3 toLinear(vec3 c) { return pow(max(c, vec3(0.0)), vec3(2.2)); }
vec3 toScene(vec3 c) { return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2)); }

vec3 unproject(ivec2 p, float depth, vec2 size) {
    vec2 uv = (vec2(p) + 0.5) / size;
    vec4 h = pc.invViewProj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return h.xyz / h.w;
}

void main() {
    ivec2 size = imageSize(sceneColor);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    uint px = uint(p.y) * uint(size.x) + uint(p.x);
    float depth = texelFetch(sceneDepth, p, 0).r;
    vec3 pos = unproject(p, depth, vec2(size));
    vec3 viewDir = normalize(pos);
    vec4 color = imageLoad(sceneColor, p);

    if (pc.flags.z < 0.5) {
        uint o = floatBitsToUint(rr[0]) + px * 3u;
        float mark = rr[o];
        if (mark > -0.5) return;   // path traced (pathtrace.rgen wrote the remodulation plane)
        uint m7 = floatBitsToUint(rr[7]) + px * 3u;
        rr[m7] = 1.0; rr[m7 + 1u] = 1.0; rr[m7 + 2u] = 1.0;
        vec3 c;
        if (mark < -1.5) {
            vec4 cl = traceClouds(viewDir, 1e9);
            c = mix(skyRadiance(viewDir), cl.rgb, cl.a);
        } else {
            float dist = length(pos);
            float vf = clamp((dist - pc.fog.w) / max(pc.fogEnd.x - pc.fog.w, 1.0), 0.0, 0.95);
            c = toLinear(max((color.rgb - pc.fog.rgb * vf) / (1.0 - vf), vec3(0.0))) * pc.skyMean.w;
            // Seen through stained glass: its tint, which pathtrace.rgen left in the albedo plane.
            uint a = floatBitsToUint(rr[5]) + px * 3u;
            c *= clamp(vec3(rr[a], rr[a + 1u], rr[a + 2u]), 0.0, 1.0);
        }
        rr[o] = c.r; rr[o + 1u] = c.g; rr[o + 2u] = c.b;
        return;
    }

    uint q = (uint(p.y) * uint(pc.flags.w) + uint(p.x)) * 3u;
    vec3 c = vec3(rrOut[q], rrOut[q + 1u], rrOut[q + 2u]);
    if (pc.flags.y > 0.5) {   // VESU_DEBUG_VIEW=ptraw/ptnrm/ptalb/ptspec: one of RR's input planes
        uint o = floatBitsToUint(rr[uint(pc.flags.y) - 1u]) + px * 3u;
        c = vec3(rr[o], rr[o + 1u], rr[o + 2u]);
    }
    if (pc.flags.y < 0.5 || pc.flags.y == 1.0) {   // the texture RR's colour was divided by
        uint m7 = floatBitsToUint(rr[7]) + px * 3u;
        c *= vec3(rr[m7], rr[m7 + 1u], rr[m7 + 2u]);
    }
    if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
    c = max(c, vec3(0.0));
    if (depth > 0.0) {
        float range = pc.lightDir.w;
        float skyFade = smoothstep(0.6 * range, 0.75 * range, length(pos));
        if (skyFade > 0.0) {
            // Into the sky as the sky pixels show it: with the clouds (at night a cloud-covered
            // sky is far darker than the clear one, a bright rim otherwise outlines the terrain).
            vec4 cl = traceClouds(viewDir, 1e9);
            c = mix(c, mix(skyRadiance(viewDir), cl.rgb, cl.a), skyFade);
        }
    }
    imageStore(sceneColor, p, vec4(toScene(c), color.a));
}
