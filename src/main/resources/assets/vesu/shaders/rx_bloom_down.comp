#version 450
#extension GL_GOOGLE_include_directive : require
#include "rx_common.glsl"
// bloom_downsample.comp.slang: 13-tap downsample (Call of Duty: Advanced Warfare), the first step
// smoothly suppressing what lies under the luminance threshold.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outColor;
layout(set = 0, binding = 1) uniform sampler2D inColor;
layout(push_constant) uniform Args { vec2 inputSizeInverse; vec2 outputSizeInverse; ivec2 outputSize; float threshold; } cb;
layout(local_size_x = 16, local_size_y = 16) in;
vec3 tap(vec2 uv, float x, float y) { return textureLod(inColor, uv + vec2(x, y) * cb.inputSizeInverse, 0.0).rgb; }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, cb.outputSize))) return;
    vec2 uv = (vec2(p) + 0.5) * cb.outputSizeInverse;
    vec3 t0 = tap(uv, -2, -2), t1 = tap(uv, 0, -2), t2 = tap(uv, 2, -2);
    vec3 t3 = tap(uv, -1, -1), t4 = tap(uv, 1, -1);
    vec3 t5 = tap(uv, -2, 0), t6 = tap(uv, 0, 0), t7 = tap(uv, 2, 0);
    vec3 t8 = tap(uv, -1, 1), t9 = tap(uv, 1, 1);
    vec3 t10 = tap(uv, -2, 2), t11 = tap(uv, 0, 2), t12 = tap(uv, 2, 2);
    vec3 a = 0.25 * (t3 + t4 + t8 + t9);
    vec3 b = 0.25 * (t0 + t1 + t5 + t6);
    vec3 c = 0.25 * (t1 + t2 + t6 + t7);
    vec3 d = 0.25 * (t5 + t6 + t10 + t11);
    vec3 e = 0.25 * (t6 + t7 + t11 + t12);
    vec3 result = 0.5 * a + 0.125 * (b + c + d + e);
    if (cb.threshold > 0.0) result *= smoothstep(0.0, cb.threshold, bt709(result));
    imageStore(outColor, p, vec4(result, 0.0));
}
