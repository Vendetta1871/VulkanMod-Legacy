#version 450
#extension GL_GOOGLE_include_directive : require
#include "rx_common.glsl"
// auto_exposure_histogram.comp.slang: EV100 histogram of the (center-weighted) luminance; nearly
// black pixels count in bucket 0.
layout(set = 0, binding = 1) uniform sampler2D hdr;
layout(set = 0, binding = 6, r32ui) uniform uimage2D histogram;
layout(push_constant) uniform Args { float evMinValue; float evRange; float centerMeteringSize; uint enableCenterMetering; } cb;
layout(local_size_x = 16, local_size_y = 16) in;
shared uint localData[HISTOGRAM_SIZE];

uint bucketOf(vec3 c) {
    float l = bt709(c);
    if (l < 0.00001) return 0u;
    float normalizedEV = clamp((luminanceEV100(l) - cb.evMinValue) / cb.evRange, 0.0, 1.0);
    return uint(normalizedEV * float(HISTOGRAM_SIZE - 2) + 1.0);
}

float centerMeteringWeight(vec2 uv, float aspect) {
    if (cb.enableCenterMetering == 0u) return 1.0;
    float w = clamp(length((uv - vec2(0.5)) / vec2(1.0, aspect)) / cb.centerMeteringSize, 0.0, 1.0);
    return mix(1.0, 0.0, w);
}

void main() {
    uint li = gl_LocalInvocationIndex;
    localData[li] = 0u;
    barrier();
    ivec2 dim = textureSize(hdr, 0);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(p, dim))) {
        vec3 c = texelFetch(hdr, p, 0).rgb * centerMeteringWeight(vec2(p) / vec2(dim), float(dim.x) / float(dim.y));
        atomicAdd(localData[bucketOf(c)], 1u);
    }
    barrier();
    if (localData[li] != 0u) imageAtomicAdd(histogram, ivec2(li, 0), localData[li]);
}
