#version 450
#extension GL_GOOGLE_include_directive : require
#include "rx_common.glsl"
// local_tonemap/blend.comp.slang: the exposures blended by their weights at the top mip.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outAssemble;
layout(set = 0, binding = 1) uniform sampler2D exposures;
layout(set = 0, binding = 2) uniform sampler2D weights;
layout(local_size_x = 16, local_size_y = 16) in;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(outAssemble)))) return;
    vec3 w = texelFetch(weights, p, 0).xyz;
    vec3 e = texelFetch(exposures, p, 0).xyz;
    w /= dot(w, vec3(1.0)) + 0.0001;
    imageStore(outAssemble, p, vec4(vec3(dot(e * w, vec3(1.0))), 1.0));
}
