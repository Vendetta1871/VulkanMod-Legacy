#version 450
#extension GL_GOOGLE_include_directive : require
#include "rx_common.glsl"
// local_tonemap/final_combine.comp.slang: guided upsampling of the assembled luminance into a
// per-pixel exposure multiplier, ACES, then the sRGB output pass (srgb_dither: pow 1/2.2) into
// the scene in display range.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outScene;
layout(set = 0, binding = 1) uniform sampler2D assemble;      // mip 0 of the assembled pyramid
layout(set = 0, binding = 2) uniform sampler2D original;      // mip 0 of the luminance pyramid
layout(set = 0, binding = 3) uniform sampler2D hdr;
layout(set = 0, binding = 5, rg32f) uniform readonly image2D exposure;
layout(push_constant) uniform Args { vec4 mipPixelSize; float exposureFactor; uint finalizeWithACES; uint showUnmapped; } cb;
layout(local_size_x = 16, local_size_y = 16) in;
void main() {
    ivec2 size = imageSize(outScene);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float avgExposure = cb.exposureFactor * imageLoad(exposure, ivec2(0)).r;
    vec3 originalColor = texelFetch(hdr, p, 0).rgb * avgExposure;
    float mX = 0.0, mY = 0.0, mX2 = 0.0, mXY = 0.0, ws = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec2 o = vec2(dx, dy) * cb.mipPixelSize.zw;
            float x = textureLod(original, uv + o, 0.0).y;
            float y = textureLod(assemble, uv + o, 0.0).x;
            float w = exp(-0.5 * float(dx * dx + dy * dy) / (0.7 * 0.7));
            mX += x * w; mY += y * w; mX2 += x * x * w; mXY += x * y * w; ws += w;
        }
    }
    mX /= ws; mY /= ws; mX2 /= ws; mXY /= ws;
    float A = (mXY - mX * mY) / (max(mX2 - mX * mX, 0.0) + 0.00001);
    float B = mY - A * mX;
    vec3 texelOriginal = linearToGamma(acesFitted(originalColor, true));
    float lum = bt709(texelOriginal) + 0.00001;
    float mult = max(A * lum + B, 0.0) / lum;
    const float lerpToUnityThreshold = 0.007;
    if (lum <= lerpToUnityThreshold) mult = mix(1.0, mult, (lum / lerpToUnityThreshold) * (lum / lerpToUnityThreshold));
    vec3 c = originalColor * mult;
    if (cb.finalizeWithACES != 0u) c = acesFitted(c, false);
    imageStore(outScene, p, vec4(linearToGamma(clamp(c, 0.0, 1.0)), texelFetch(hdr, p, 0).a));
}
