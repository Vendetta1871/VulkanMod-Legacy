#version 450
#extension GL_GOOGLE_include_directive : require
#include "rx_common.glsl"
// local_tonemap/blend_laplacian.comp.slang: the finer level's Laplacians blended by its weights,
// added to the coarser assembled level.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outAssemble;
layout(set = 0, binding = 1) uniform sampler2D exposures;
layout(set = 0, binding = 2) uniform sampler2D exposuresCoarser;
layout(set = 0, binding = 3) uniform sampler2D weights;
layout(set = 0, binding = 4) uniform sampler2D accumulate;
layout(local_size_x = 16, local_size_y = 16) in;
void main() {
    ivec2 res = imageSize(outAssemble);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, res))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(res);
    float accumSoFar = textureLod(accumulate, uv, 0.0).x;
    vec3 laplacians = textureLod(exposures, uv, 0.0).xyz - textureLod(exposuresCoarser, uv, 0.0).xyz;
    vec3 w = textureLod(weights, uv, 0.0).xyz;
    w /= dot(w, vec3(1.0)) + 0.00001;
    imageStore(outAssemble, p, vec4(vec3(accumSoFar + dot(laplacians * w, vec3(1.0))), 1.0));
}
