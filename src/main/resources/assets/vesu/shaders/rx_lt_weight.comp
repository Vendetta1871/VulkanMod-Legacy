#version 450
#extension GL_GOOGLE_include_directive : require
#include "rx_common.glsl"
// local_tonemap/exposure_weight.comp.slang: well-exposedness weights of the three exposures.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outWeight;
layout(set = 0, binding = 1) uniform sampler2D luminance;
layout(push_constant) uniform Args { float sigmaSq; float offset; } cb;
layout(local_size_x = 16, local_size_y = 16) in;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(outWeight)))) return;
    vec3 diff = texelFetch(luminance, p, 0).xyz - vec3(0.5 + cb.offset);
    vec3 w = exp(-0.5 * diff * diff * cb.sigmaSq);
    w /= dot(w, vec3(1.0)) + 0.00001;
    imageStore(outWeight, p, vec4(w, 1.0));
}
