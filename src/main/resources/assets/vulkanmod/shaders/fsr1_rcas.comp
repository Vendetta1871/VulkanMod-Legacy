#version 450
// FSR 1 RCAS sharpening: intermediate -> display color (both display res).
#extension GL_GOOGLE_include_directive : require
#define FFX_GPU 1
#define FFX_GLSL 1
#define FSR_RCAS_F 1
#include "ffx/ffx_core.h"

layout(set = 0, binding = 0) uniform sampler2D inputColor;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform Constants {
    uvec4 con0;
} pc;

FfxFloat32x4 FsrRcasLoadF(FfxInt32x2 p) { return texelFetch(inputColor, p, 0); }
void FsrRcasInputF(inout FfxFloat32 r, inout FfxFloat32 g, inout FfxFloat32 b) {}

#include "ffx/fsr1/ffx_fsr1.h"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    uvec2 ip = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(ip, uvec2(imageSize(outputImage))))) return;
    vec3 color;
    FsrRcasF(color.r, color.g, color.b, ip, pc.con0);
    imageStore(outputImage, ivec2(ip), vec4(color, 1.0));
}
