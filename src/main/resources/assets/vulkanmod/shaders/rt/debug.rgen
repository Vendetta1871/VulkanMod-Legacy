#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// RT debug view: primary rays from the main camera (camera-relative, world-aligned axes),
// textured albedo, sun/moon diffuse with a ray-traced shadow, sky-light ambient.

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform Constants {
    mat4 invViewProj;   // unjittered, Vulkan depth
    vec4 sunDir;        // xyz: towards the sun, w: daylight 0..1
} pc;

layout(location = 0) rayPayloadEXT Payload payload;
layout(location = 1) rayPayloadEXT float visible;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    // The viewport flips Y: NDC +1 is the top row.
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 nearP = pc.invViewProj * vec4(ndc, 0.0, 1.0);
    vec4 farP = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 origin = nearP.xyz / nearP.w;
    vec3 dir = normalize(farP.xyz / farP.w - origin);

    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x03, 0, 0, 0, origin, 0.0, dir, 4096.0, 0);

    vec3 color;
    if (payload.t < 0.0) {
        color = mix(vec3(0.02, 0.03, 0.08), vec3(0.45, 0.62, 0.95), pc.sunDir.w);
    } else {
        // Sun by day, moon (opposite, dimmer) by night.
        vec3 light = pc.sunDir.y >= 0.0 ? pc.sunDir.xyz : -pc.sunDir.xyz;
        float strength = pc.sunDir.y >= 0.0 ? 1.0 : 0.15;
        float ndl = max(dot(payload.normal, light), 0.0);
        visible = 0.0;
        if (ndl > 0.0) {
            vec3 p = origin + dir * payload.t + payload.normal * 0.01;
            traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 1, p, 0.0, light, 512.0, 1);
        }
        float ambient = 0.08 + 0.32 * payload.skyLight * (0.25 + 0.75 * pc.sunDir.w);
        color = payload.albedo * (ambient + strength * ndl * visible * payload.skyLight);
    }
    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
