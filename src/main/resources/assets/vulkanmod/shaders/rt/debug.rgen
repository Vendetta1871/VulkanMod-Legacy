#version 460
#extension GL_EXT_ray_tracing : require
// RT debug view: primary rays from the main camera (camera-relative space).

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform Constants {
    mat4 invViewProj;   // unjittered, Vulkan depth
} pc;

layout(location = 0) rayPayloadEXT vec4 payload;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    // The viewport flips Y: NDC +1 is the top row.
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 nearP = pc.invViewProj * vec4(ndc, 0.0, 1.0);
    vec4 farP = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 origin = nearP.xyz / nearP.w;
    vec3 dir = normalize(farP.xyz / farP.w - origin);

    payload = vec4(0.0);
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, 0.0, dir, 4096.0, 0);
    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(payload.rgb, 1.0));
}
