#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// Hybrid RT lighting (T8): per scene pixel, reconstructed from the depth buffer and
// refined by a short primary ray, traces
//  - one shadow ray towards the sun or moon,
//  - one shadow ray towards a block light picked by ReSTIR DI: resampled importance
//    sampling among the lights of the pixel's grid cell, merged with the reservoirs of the
//    reprojected pixel and three neighbours from the previous frame (temporal and spatial
//    reuse, after Bitterli et al. 2020); its noisy estimate is accumulated over
//    frames (depth-validated reprojection) into the history image. Shadow rays pass through
//    stained glass and ice and take their color.
//  - one cosine-distributed indirect (GI) ray on half the pixels per frame, shaded from its hit's albedo and lightmap
//    (sky color on a miss where the pixel sees the sky), accumulated likewise.
// rt_composite.comp filters the histories spatially and relights the scene color.

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 4) uniform sampler2D sceneDepth;
layout(set = 0, binding = 6, scalar) readonly buffer Lights { vec4 lights[]; };       // xyz: center rel. origin, w: level
layout(set = 0, binding = 7, scalar) readonly buffer Grid { ivec4 cells[]; };          // cell xyz, start | count << 24
layout(set = 0, binding = 8, scalar) readonly buffer LightIndex { int lightIndex[]; };
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D historyPrev;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D historyCur;   // rgb: block light, a: frames
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D aux;          // y: vanilla block, z: sky term, w: fade (-1 none, 0 no hit)
layout(set = 0, binding = 12, rgba8) uniform writeonly image2D normals;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D giPrev;
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D giCur;      // rgb: indirect light, a: distance
layout(set = 0, binding = 15, rgba8) uniform writeonly image2D aux2;         // rgb: sun factor, a: indirect light fade
layout(set = 0, binding = 17, rgba32f) uniform readonly image2D reservoirPrev;
layout(set = 0, binding = 18, rgba32f) uniform writeonly image2D reservoirCur; // x: light index (bits), y: W, z: M

layout(push_constant) uniform Constants {
    mat4 invViewProj;   // jittered: the depth was rendered with it
    mat4 prevViewProj;  // camera-relative position -> previous clip space
    vec4 light;         // xyz: towards the sun/moon, w: sun shadow strength
    vec4 params;        // x: shadow range (blocks), y: frame, z: history valid, w: grid mask
    vec4 cam;           // xyz: camera - light origin, w: light count
    vec4 camDelta;      // xyz: previous camera - camera, w: sky brightness factor
    vec4 sky;           // rgb: sky radiance (luminance 1), w: indirect light range (blocks, 0: off)
    vec4 restir;        // x: 1 when the previous reservoirs' light indices are still valid
} pc;

layout(location = 0) rayPayloadEXT Payload payload;
layout(location = 1) rayPayloadEXT vec4 shadow;

const int CELL = 8;
const int MAX_CANDIDATES = 8;
const float MAX_FRAMES = 24.0;

// Vanilla's lightmap curve for a 0..1 light level.
float brightness(float l) { return l / (4.0 - 3.0 * l); }

uint rngState;
uint pcg() {
    rngState = rngState * 747796405u + 2891336453u;
    uint w = ((rngState >> ((rngState >> 28u) + 4u)) ^ rngState) * 277803737u;
    return (w >> 22u) ^ w;
}
float rand() { return float(pcg() >> 8) * (1.0 / 16777216.0); }

vec3 unproject(ivec2 p, float depth, vec2 size) {
    vec2 uv = (vec2(p) + 0.5) / size;
    // The viewport flips Y: NDC +1 is the top row.
    vec4 h = pc.invViewProj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return h.xyz / h.w;
}

// Of the two neighbours along an axis, the one closer in depth gives the surface tangent.
vec3 tangent(ivec2 p, ivec2 axis, float d, vec3 pos, ivec2 size) {
    ivec2 a = p + axis;
    ivec2 b = p - axis;
    bool hasA = all(lessThan(a, size));
    bool hasB = all(greaterThanEqual(b, ivec2(0)));
    float da = hasA ? texelFetch(sceneDepth, a, 0).r : 2.0;
    float db = hasB ? texelFetch(sceneDepth, b, 0).r : 2.0;
    return abs(da - d) < abs(db - d)
            ? unproject(a, da, vec2(size)) - pos
            : pos - unproject(b, db, vec2(size));
}

// Light reaching the end of the ray: 0 when occluded, the filter color through stained glass.
vec3 traceShadow(vec3 origin, vec3 dir, float tMax) {
    shadow = vec4(1.0, 1.0, 1.0, 0.0);
    traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                0x0F, SHADOW_HIT_GROUP, 0, 1, origin, 0.0, dir, tMax, 1);
    return shadow.rgb * shadow.a;
}

int findCell(ivec3 c) {
    int mask = int(pc.params.w);
    int slot = (c.x * 73856093 ^ c.y * 19349663 ^ c.z * 83492791) & mask;
    for (int i = 0; i <= mask; i++) {
        ivec4 e = cells[slot];
        if (e.x == int(0x80000000)) return -1;
        if (e.xyz == c) return slot;
        slot = (slot + 1) & mask;
    }
    return -1;
}

// Unshadowed block light from one emitter: vanilla's level falloff (one level per block)
// through the brightness curve, shaped by the angle of incidence.
float lightTarget(vec4 l, vec3 pos, vec3 n, out vec3 toLight, out float dist) {
    toLight = l.xyz - pc.cam.xyz - pos;
    dist = length(toLight);
    float level = l.w - max(dist - 0.5, 0.0);
    if (level <= 0.0) return 0.0;
    float ndl = dot(n, toLight) / max(dist, 1e-4);
    if (ndl <= 0.0) return 0.0;
    return brightness(level / 15.0) * (0.35 + 0.65 * ndl);
}

// Distance along the ray at which it enters the light's own block (stops the shadow ray there).
float blockEntry(vec3 origin, vec3 dir, vec3 center) {
    vec3 inv = 1.0 / dir;
    vec3 t0 = (center - 0.5 - origin) * inv;
    vec3 t1 = (center + 0.5 - origin) * inv;
    vec3 tmin = min(t0, t1);
    return max(max(tmin.x, tmin.y), tmin.z);
}

struct Reservoir {
    int light;    // -1: none
    float wsum;
    float M;
    float target; // target function of the chosen light at this pixel
};

const float RESERVOIR_M_CAP = 20.0;

float targetOf(int li, vec3 pos, vec3 n) {
    if (li < 0 || li >= int(pc.cam.w)) return 0.0;
    vec3 toLight;
    float dist;
    return lightTarget(lights[li], pos, n, toLight, dist);
}

void addCandidate(inout Reservoir r, int li, float target, float weight, float m) {
    r.wsum += weight;
    r.M += m;
    if (weight > 0.0 && rand() * r.wsum < weight) {
        r.light = li;
        r.target = target;
    }
}

// Merges a previous-frame reservoir, re-evaluating its light at this pixel.
void mergeReservoir(inout Reservoir r, ivec2 q, vec3 pos, vec3 n) {
    vec4 pr = imageLoad(reservoirPrev, q);
    int li = floatBitsToInt(pr.x);
    float m = min(pr.z, RESERVOIR_M_CAP);
    if (li < 0 || m <= 0.0 || !(pr.y > 0.0)) return;
    float t = targetOf(li, pos, n);
    addCandidate(r, li, t, t * pr.y * m, m);
}

// Block light at a surface: ReSTIR picks one emitter, a shadow ray to a random point in its
// block (soft shadows over the accumulated frames, colored through glass) checks it.
vec3 blockLight(vec3 pos, vec3 n, ivec2 p, ivec2 prevPixel, bool reuse) {
    Reservoir r = Reservoir(-1, 0.0, 0.0, 0.0);
    if (pc.cam.w > 0.0) {
        vec3 q = pos + pc.cam.xyz;
        int slot = findCell(ivec3(floor(q / float(CELL))));
        if (slot >= 0) {
            int packed = cells[slot].w;
            int start = packed & 0xFFFFFF;
            int count = (packed >> 24) & 0xFF;
            int candidates = min(count, MAX_CANDIDATES);
            for (int k = 0; k < candidates; k++) {
                int i = count <= MAX_CANDIDATES ? k : int(rand() * float(count));
                int li = lightIndex[start + min(i, count - 1)];
                float t = targetOf(li, pos, n);
                // Source pdf: uniform over the cell's lights (1 / count) per candidate.
                addCandidate(r, li, t, t * float(count) / float(candidates), 1.0 / float(candidates));
            }
            // The streamed candidates count as one sample of M.
            if (candidates > 0) r.M = 1.0;
        }
    }
    if (reuse) {
        ivec2 size = ivec2(gl_LaunchSizeEXT.xy);
        mergeReservoir(r, prevPixel, pos, n);
        for (int k = 0; k < 3; k++) {
            float ang = 6.2831853 * rand();
            ivec2 q = prevPixel + ivec2(vec2(cos(ang), sin(ang)) * (2.0 + 10.0 * rand()));
            if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, size))) mergeReservoir(r, q, pos, n);
        }
    }

    float W = r.light >= 0 && r.target > 0.0 && r.M > 0.0 ? r.wsum / (r.M * r.target) : 0.0;
    imageStore(reservoirCur, p, vec4(intBitsToFloat(r.light), W, r.M, 0.0));
    if (W <= 0.0) return vec3(0.0);

    // A random point inside the emitter's block: soft shadows over the accumulated frames.
    vec3 center = lights[r.light].xyz - pc.cam.xyz;
    vec3 target = center + (vec3(rand(), rand(), rand()) - 0.5) * 0.6;
    vec3 origin = pos + n * 0.02;
    vec3 dir = target - origin;
    float len = length(dir);
    dir /= max(len, 1e-4);
    float tMax = blockEntry(origin, dir, center) - 0.01;
    vec3 vis = tMax > 0.05 ? traceShadow(origin, dir, tMax) : vec3(1.0);
    return vis * (r.target * W);
}

// One cosine-weighted bounce: the hit's albedo times its vanilla light and face shading;
// a miss sees the sky, scaled by how much sky this pixel's lightmap says it sees.
vec3 indirect(vec3 pos, vec3 n, float skyLight) {
    vec3 t1 = normalize(abs(n.y) < 0.9 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 t2 = cross(n, t1);
    float phi = 6.2831853 * rand();
    float r2 = rand();
    float sr = sqrt(r2);
    vec3 dir = normalize(t1 * (cos(phi) * sr) + t2 * (sin(phi) * sr) + n * sqrt(1.0 - r2));
    if (any(isnan(dir)) || any(isnan(pos))) return vec3(0.0);
    payload.t = -1.0;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x03, 0, 0, 0, pos + n * 0.02, 0.0, dir, 128.0, 0);
    if (payload.t < 0.0) return pc.sky.rgb * pc.camDelta.w * brightness(skyLight);
    vec3 hn = payload.normal;
    float face = abs(hn.y) > 0.5 ? (hn.y > 0.0 ? 1.0 : 0.5) : (abs(hn.z) > 0.5 ? 0.8 : 0.6);
    float light = max(brightness(payload.skyLight) * pc.camDelta.w, brightness(payload.blockLight));
    return payload.albedo * light * face;
}

void main() {
    ivec2 p = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);
    float d = texelFetch(sceneDepth, p, 0).r;
    if (d >= 0.99999) {   // sky, clouds past the far plane
        imageStore(aux, p, vec4(1.0, 0.0, 0.0, -1.0));
        imageStore(aux2, p, vec4(1.0, 1.0, 1.0, 0.0));
        imageStore(historyCur, p, vec4(0.0));
        imageStore(reservoirCur, p, vec4(intBitsToFloat(-1), 0.0, 0.0, 0.0));
        imageStore(giCur, p, vec4(0.0));
        return;
    }

    vec3 pos = unproject(p, d, vec2(size));
    // Past an effect's range the raster image stays as is; the last chunk fades out.
    float horizontal = max(abs(pos.x), abs(pos.z));
    float fade = clamp((pc.params.x - horizontal) / 16.0, 0.0, 1.0);
    float giFade = clamp((pc.sky.w - horizontal) / 16.0, 0.0, 1.0);
    vec3 c = cross(tangent(p, ivec2(1, 0), d, pos, size), tangent(p, ivec2(0, 1), d, pos, size));
    // Degenerate or non-finite geometry: never trace a NaN ray (software traversal on GPUs
    // without RT cores can spin on it).
    float len2 = dot(c, c);
    if ((fade <= 0.0 && giFade <= 0.0) || !(len2 > 1e-20) || any(isnan(pos)) || any(isinf(pos))) {
        imageStore(aux, p, vec4(1.0, 0.0, 0.0, -1.0));
        imageStore(aux2, p, vec4(1.0, 1.0, 1.0, 0.0));
        imageStore(historyCur, p, vec4(0.0));
        imageStore(reservoirCur, p, vec4(intBitsToFloat(-1), 0.0, 0.0, 0.0));
        imageStore(giCur, p, vec4(0.0));
        return;
    }
    vec3 n = c * inversesqrt(len2);
    vec3 eye = unproject(p, 0.0, vec2(size));
    vec3 view = pos - eye;
    if (dot(n, view) > 0.0) n = -n;
    float dist = length(view);

    rngState = uint(p.x) * 1973u + uint(p.y) * 9277u + uint(pc.params.y) * 26699u;
    pcg();

    // Primary ray around the depth sample (terrain masks only; entity hits carry no
    // chunk vertices): exact normal and the surface's lightmap.
    // No hit (entities, clouds - not in the TLAS): depth normal, sun shadows only.
    payload.t = -1.0;
    vec3 dir = view / dist;
    float slack = 0.05 + 0.01 * dist;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0x03, 0, 0, 0, eye, max(dist - slack, 0.0), dir, dist + slack, 0);
    bool hit = payload.t >= 0.0;
    if (hit && !any(isnan(payload.normal))) {
        n = payload.normal;
        pos = eye + dir * payload.t;
    }

    // Sun/moon: only occlusion darkens (colored through stained glass); faces turned away
    // keep vanilla's face shading.
    vec3 sunFactor = vec3(1.0);
    float ndl = dot(n, pc.light.xyz);
    float sky = hit ? payload.skyLight : 1.0;
    if (fade > 0.0 && pc.light.w > 0.0 && ndl > 0.0 && sky > 0.01) {
        vec3 lit = traceShadow(pos + n * (0.02 + 0.002 * dist), pc.light.xyz, 512.0);
        sunFactor = 1.0 - pc.light.w * fade * (1.0 - lit);
    }
    imageStore(normals, p, vec4(n * 0.5 + 0.5, 1.0));
    float distance = length(pos);

    if (!hit) {
        imageStore(aux, p, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(aux2, p, vec4(sunFactor, 0.0));
        imageStore(historyCur, p, vec4(0.0));
        imageStore(reservoirCur, p, vec4(intBitsToFloat(-1), 0.0, 0.0, 0.0));
        imageStore(giCur, p, vec4(0.0, 0.0, 0.0, distance));
        return;
    }
    float skyLight = payload.skyLight, blockLevel = payload.blockLight;

    // The previous frame's pixel of this surface (nearest, distance-validated) for ReSTIR reuse.
    ivec2 prevPixel = p;
    bool reuse = false;
    if (pc.params.z > 0.0 && pc.restir.x > 0.0) {
        vec4 clip = pc.prevViewProj * vec4(pos, 1.0);
        if (clip.w > 0.0) {
            vec2 uv = clip.xy / clip.w * vec2(0.5, -0.5) + 0.5;
            prevPixel = ivec2(floor(uv * vec2(size)));
            if (all(greaterThanEqual(prevPixel, ivec2(0))) && all(lessThan(prevPixel, size))) {
                float expected = length(pos - pc.camDelta.xyz);
                reuse = abs(imageLoad(giPrev, prevPixel).a - expected) < 0.05 * expected + 0.1;
            }
        }
    }
    vec3 rt = vec3(0.0);
    if (fade > 0.0) {
        rt = min(blockLight(pos, n, p, prevPixel, reuse), vec3(1.5));
    } else {
        imageStore(reservoirCur, p, vec4(intBitsToFloat(-1), 0.0, 0.0, 0.0));
    }

    // Temporal accumulation: bilinear reprojection, taps whose stored distance disagrees
    // with this surface (disocclusion) are dropped.
    vec3 prev = vec3(0.0);
    float frames = 0.0;
    vec3 giHist = vec3(0.0);
    if (pc.params.z > 0.0) {
        vec4 clip = pc.prevViewProj * vec4(pos, 1.0);
        if (clip.w > 0.0) {
            vec2 uv = clip.xy / clip.w * vec2(0.5, -0.5) + 0.5;
            vec2 texel = uv * vec2(size) - 0.5;
            ivec2 base = ivec2(floor(texel));
            vec2 f = texel - vec2(base);
            float expected = length(pos - pc.camDelta.xyz);
            float wsum = 0.0;
            for (int i = 0; i < 4; i++) {
                ivec2 o = ivec2(i & 1, i >> 1);
                ivec2 q = base + o;
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
                vec4 h = imageLoad(historyPrev, q);
                vec4 g = imageLoad(giPrev, q);
                if (h.a <= 0.0 || abs(g.a - expected) > 0.03 * expected + 0.05) continue;
                float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
                prev += h.rgb * w;
                frames += h.a * w;
                giHist += g.rgb * w;
                wsum += w;
            }
            if (wsum > 0.05) {
                prev /= wsum;
                frames /= wsum;
                giHist /= wsum;
            } else {
                prev = vec3(0.0);
                frames = 0.0;
                giHist = vec3(0.0);
            }
        }
    }
    frames = min(frames + 1.0, MAX_FRAMES);
    imageStore(historyCur, p, vec4(mix(prev, rt, 1.0 / frames), frames));

    // Indirect light on a checkerboard alternating per frame (half the rays); the other
    // pixels keep their reprojected history unless they have none.
    vec3 giNew = vec3(0.0);
    if (giFade > 0.0) {
        bool trace = frames <= 1.0 || ((p.x + p.y + int(pc.params.y)) & 1) == 0;
        giNew = trace ? mix(giHist, indirect(pos, n, skyLight), 1.0 / max(frames * 0.5, 1.0)) : giHist;
    }
    imageStore(giCur, p, vec4(giNew, distance));
    imageStore(aux2, p, vec4(sunFactor, giFade));

    float skyTerm = brightness(skyLight) * pc.camDelta.w;
    // w > 0 marks a hit; a pixel past the shadow range keeps vanilla block light.
    imageStore(aux, p, vec4(0.0, brightness(blockLevel), skyTerm, max(fade, 1e-4)));
}
