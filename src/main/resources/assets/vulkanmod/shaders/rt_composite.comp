#version 450
// T8: applies the RT lighting from lighting.rgen to the scene color. The accumulated block
// light is filtered with an edge-aware 5x5 kernel (wider while the history is short), then
// the pixel is relit: vanilla's light (sky + block) is replaced by the shadowed sun share
// plus the ray-traced block light and a fraction of vanilla's block light as bounce, and the
// indirect light as a correction of vanilla's sky ambient (occlusion darkens, bounces tint).

layout(set = 0, binding = 0) uniform sampler2D sceneDepth;
layout(set = 0, binding = 1, rgba8) uniform image2D sceneColor;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D history;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D aux;
layout(set = 0, binding = 4, rgba8) uniform readonly image2D normals;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D gi;      // rgb: indirect light, a: distance
layout(set = 0, binding = 6, rgba8) uniform readonly image2D aux2;     // rgb: sun factor, a: indirect light fade
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D blockDenoised;   // NRD outputs
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D giDenoised;
layout(set = 0, binding = 9, rgba8) uniform readonly image2D albedo;   // texture * vertex tint

layout(push_constant) uniform Constants {
    mat4 invViewProj;   // jittered
    vec4 params;        // x: block light strength, y: bounce share, z: debug view (1: block, 2: GI), w: GI strength
    vec4 flags;         // x: NRD outputs replace the own filter
} pc;

layout(local_size_x = 8, local_size_y = 8) in;

const float AMBIENT = 0.03;

vec3 unproject(ivec2 p, float depth, vec2 size) {
    vec2 uv = (vec2(p) + 0.5) / size;
    vec4 h = pc.invViewProj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return h.xyz / h.w;
}

void main() {
    ivec2 size = imageSize(sceneColor);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;

    vec4 a = imageLoad(aux, p);
    if (a.w < 0.0) return;
    vec4 color = imageLoad(sceneColor, p);
    vec4 a2 = imageLoad(aux2, p);
    if (a.x > 0.5) {
        // A light source's own surface: fully lit in its own colors (vanilla leaves blocks
        // that glow only for RT, like redstone, dark).
        vec4 c = imageLoad(sceneColor, p);
        imageStore(sceneColor, p, vec4(max(c.rgb, imageLoad(albedo, p).rgb), c.a));
        return;
    }
    if (a.w == 0.0) {
        // No primary hit (entities): sun shadows only.
        imageStore(sceneColor, p, vec4(color.rgb * a2.rgb, color.a));
        return;
    }

    vec4 h = imageLoad(history, p);
    vec3 n = imageLoad(normals, p).xyz * 2.0 - 1.0;
    vec3 pos = unproject(p, texelFetch(sceneDepth, p, 0).r, vec2(size));
    float dist = length(pos);
    int stride = h.a < 6.0 ? 3 : h.a < 16.0 ? 2 : 1;
    bool nrd = pc.flags.x > 0.0;

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    vec3 giSum = vec3(0.0);
    float giW = 0.0;
    // With NRD the own filter is skipped (empty loop).
    for (int dy = nrd ? 3 : -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 q = p + ivec2(dx, dy) * stride;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            if (imageLoad(aux, q).w <= 0.0) continue;
            vec4 hq = imageLoad(history, q);
            vec3 nq = imageLoad(normals, q).xyz * 2.0 - 1.0;
            vec3 pq = unproject(q, texelFetch(sceneDepth, q, 0).r, vec2(size));
            float plane = abs(dot(n, pq - pos)) / (0.02 + 0.004 * dist);
            float w = exp(-0.25 * float(dx * dx + dy * dy)) * pow(max(dot(n, nq), 0.0), 32.0) * exp(-plane)
                    * (0.25 + min(hq.a, 8.0));
            sum += hq.rgb * w;
            wsum += w;
            // Indirect light is low-frequency: a second, twice as wide footprint.
            ivec2 g = p + ivec2(dx, dy) * stride * 2;
            if (all(greaterThanEqual(g, ivec2(0))) && all(lessThan(g, size)) && imageLoad(aux, g).w > 0.0) {
                vec3 ng = imageLoad(normals, g).xyz * 2.0 - 1.0;
                vec3 pg = unproject(g, texelFetch(sceneDepth, g, 0).r, vec2(size));
                float gw = exp(-0.12 * float(dx * dx + dy * dy)) * pow(max(dot(n, ng), 0.0), 8.0)
                        * exp(-abs(dot(n, pg - pos)) / (0.05 + 0.006 * dist));
                giSum += imageLoad(gi, g).rgb * gw;
                giW += gw;
            }
        }
    }
    vec3 rt = wsum > 0.0 ? sum / wsum : h.rgb;
    vec3 indirect = giW > 0.0 ? giSum / giW : imageLoad(gi, p).rgb;
    if (nrd) {
        rt = max(imageLoad(blockDenoised, p).rgb, vec3(0.0));
        indirect = max(imageLoad(giDenoised, p).rgb, vec3(0.0));
    }

    vec3 sunFactor = a2.rgb;
    float giFade = a2.a, vanillaBlock = a.y, skyTerm = a.z, fade = a.w;
    // Several emitters add up where vanilla takes the brightest: the cap keeps lit areas
    // near vanilla's level while shadows, falloff and glass tint come from the rays.
    // The bounce share follows the traced light's hue (light through colored glass stays colored).
    float rtMax = max(max(rt.r, rt.g), rt.b);
    vec3 hue = rtMax > 0.02 ? rt / rtMax : vec3(1.0);
    vec3 traced = 1.3 * rt + pc.params.y * vanillaBlock * hue;
    vec3 block = mix(vec3(vanillaBlock), traced, pc.params.x * fade);
    // Open ground under the sky gathers about skyTerm: the difference is occlusion or bounce.
    vec3 giDelta = pc.params.w * giFade * (indirect - vec3(skyTerm));
    vec3 lightNew = AMBIENT + skyTerm * sunFactor + block + giDelta;
    float lightOld = AMBIENT + skyTerm + vanillaBlock;
    vec3 ratio = lightNew / lightOld;
    if (pc.params.z > 1.5) {
        imageStore(sceneColor, p, vec4(indirect, color.a));
        return;
    }
    if (pc.params.z > 0.0) {
        imageStore(sceneColor, p, vec4(rt, color.a));
        return;
    }
    // Relighting scales vanilla's color (keeping its fog and shading). Where vanilla's light is
    // (near) black that cannot add light - a fresh emitter in a chunk vanilla has not
    // relit, light around corners - so dark pixels are lit from their albedo instead.
    vec3 relit = color.rgb * clamp(ratio, vec3(0.0), vec3(2.0));
    vec3 fromAlbedo = imageLoad(albedo, p).rgb * clamp(lightNew, vec3(0.0), vec3(1.0));
    float dark = (1.0 - smoothstep(0.08, 0.3, lightOld)) * fade;
    imageStore(sceneColor, p, vec4(mix(relit, max(relit, fromAlbedo), dark), color.a));
}
